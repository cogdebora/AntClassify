),
"man/ant_community.Rd"
)
load("~/PastinhadoR/AntClassify/AntClassify/data/ant_community.rda")
tools::checkRd("man/ant_community.Rd")
# carregue o dataset no ambiente para que promptData o encontre
load("data/ant_community.rda")
# remova o arquivo antigo
if (file.exists("man/ant_community.Rd")) file.remove("man/ant_community.Rd")
# crie o novo arquivo (será colocado em man/ant_community.Rd)
promptData(ant_community, filename = "man/ant_community.Rd")
utils::globalVariables(c("species", "prop_community"))
writeLines('utils::globalVariables(c("species", "prop_community"))', "R/globals.R")
devtools::document()
devtools::check(cran = TRUE, manual = FALSE, vignettes = FALSE)
writeLines(
c(
"\\name{ant_community}",
"\\alias{ant_community}",
"\\docType{data}",
"\\title{Ant community example}",
"\\description{",
