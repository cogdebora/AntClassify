)
# Deve rodar SEM chamar GBIF
res <- antclassify(comm, verbose = TRUE, plot = FALSE, validate = FALSE)
# Verificar estrutura
names(res)
# Deve retornar: guilds, exotic, endemic, rarity
# Pode demorar por causa das chamadas GBIF
res2 <- antclassify(comm, verbose = TRUE, plot = FALSE, validate = TRUE, delay = 0.5)
comm_teste <- data.frame(
`Atta sexdens` = c(1, 2),
`Camponotus atriceps` = c(2, 0),
check.names = FALSE
)
system.time(
validate_species_names(comm_teste, verbose = TRUE, delay = 2)
)
# Deve dar erro
try(check_exotic_ants(list(a = 1, b = 2)))
try(check_exotic_ants(data.frame(A = c("a", "b"))))
# Sem erros ao gerar e imprimir
r <- check_rarity_atlantic_ants(comm_teste, verbose = TRUE, plot = TRUE,
plot_type = "status", validate = FALSE)
devtools::load_all()
# Deve validar uma única vez e sem validações repetidas
res <- antclassify(comm, verbose = TRUE, plot = FALSE, validate = TRUE, delay = 0.5)
# Teste do delay (2 espécies: deve demorar ~2 segundos, não 4)
system.time(validate_species_names(comm_teste, verbose = TRUE, delay = 2))
# Verifique que validate = FALSE não chama GBIF
res2 <- antclassify(comm, verbose = TRUE, plot = FALSE, validate = FALSE)
