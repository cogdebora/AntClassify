###############################################################################
# AntClassify - Example code for the manuscript
#
# This script reproduces all analyses and figures shown in the
# Illustrative Example section of the paper:
# "AntClassify: An R Package for Standardized Classification of Ant Communities"
#
# Supplementary Material S2
###############################################################################
# Load the package
library(AntClassify)
# Create example dataset (35 species)
data <- data.frame(
Atta_sexdens = 50,
Camponotus_atriceps = 40,
Crematogaster_sp = 35,
Cyphomyrmex_minutus = 30,
Cyphomyrmex_rimosus = 28,
Ectatomma_edentatum = 25,
Heteroponera_mayri = 22,
Holcoponera_striatula = 20,
Monomorium_floricola = 18,
Monomorium_pharaonis = 17,
Pheidole_megacephala = 16,
Strumigenys_emmae = 15,
Strumigenys_rogeri = 14,
Nylanderia_fulva = 13,
Odontomachus_chelifer = 12,
Oxyepoecus_reticulatus = 11,
Pachycondyla_striata = 10,
Apterostigma_serratum = 9,
Brachymyrmex_delabiei = 8,
Brachymyrmex_feitosai = 7,
Camponotus_fallatus = 6,
Camponotus_hermanni = 5,
Camponotus_xanthogaster = 4,
Pheidole_aberrans = 3,
Pheidole_fimbriata = 3,
Pheidole_obscurithorax = 2,
Pheidole_subarmata = 2,
Strumigenys_fridericimuelleri = 2,
Heteroponera_inermis = 2,
Oxyepoecus_browni = 2,
Sphinctomyrmex_stali = 1,
Strumigenys_sanctipauli = 1,
Brachymyrmex_micromegas = 1,
Camponotus_tripartitus = 1,
Diaphoromyrma_sofiae = 1
)
# Standardise species names (replace underscores with spaces)
colnames(data) <- gsub("_", " ", colnames(data))
# Run the full pipeline (validation disabled for speed)
cat("\n=== Running the full AntClassify pipeline ===\n")
results <- antclassify(data, validate = FALSE, plot = FALSE)
# --- Optionally, run individual functions ---
# 1. Functional Guild Classification
cat("\n=== Functional Guild Classification ===\n")
guild_results <- assign_guild_ants(data, validate = FALSE, plot = FALSE)
print(head(guild_results$table))
# 2. Exotic Species Detection
cat("\n=== Exotic Species Detection ===\n")
exotic_results <- check_exotic_ants(data, validate = FALSE, plot = FALSE)
print(exotic_results$table)
# 3. Endemic Species (Atlantic Forest)
cat("\n=== Endemic Species (Atlantic Forest) ===\n")
endemic_results <- check_endemic_atlantic_ants(data, validate = FALSE, plot = FALSE)
print(endemic_results$table)
# 4. Rarity Classification
cat("\n=== Rarity Classification (Rabinowitz 1981) ===\n")
rarity_results <- check_rarity_atlantic_ants(data, validate = FALSE, plot = FALSE)
print(rarity_results$table)
# --- Generate figures (saving to files) ---
cat("\n=== Saving figures ===\n")
if (requireNamespace("ggplot2", quietly = TRUE)) {
# Guild plots (four systems)
ggplot2::ggsave("guild_antclassify.pdf", guild_results$plots[[1]], width = 8, height = 6)
ggplot2::ggsave("guild_silva.pdf", guild_results$plots[[2]], width = 8, height = 6)
ggplot2::ggsave("guild_delabie.pdf", guild_results$plots[[3]], width = 8, height = 6)
ggplot2::ggsave("guild_silvestre.pdf", guild_results$plots[[4]], width = 8, height = 6)
cat("  - Guild figures saved: guild_antclassify.pdf, guild_silva.pdf, guild_delabie.pdf, guild_silvestre.pdf\n")
# Exotic species plot
ggplot2::ggsave("exotic_status.pdf", exotic_results$plot, width = 8, height = 6)
cat("  - Exotic figure saved: exotic_status.pdf\n")
# Endemic species plot
ggplot2::ggsave("endemic_status.pdf", endemic_results$plot, width = 8, height = 6)
cat("  - Endemic figure saved: endemic_status.pdf\n")
# Rarity plots (two types)
rarity_status <- check_rarity_atlantic_ants(data, validate = FALSE, plot = FALSE, plot_type = "status")
rarity_species <- check_rarity_atlantic_ants(data, validate = FALSE, plot = FALSE, plot_type = "species")
ggplot2::ggsave("rarity_status.pdf", rarity_status$plot, width = 8, height = 6)
ggplot2::ggsave("rarity_species.pdf", rarity_species$plot, width = 9, height = 7)
cat("  - Rarity figures saved: rarity_status.pdf, rarity_species.pdf\n")
}
cat("\n=== Analysis complete ===\n")
devtools::check()
devtools::check(args = c('--as-cran'))
devtools::check_win_devel()
devtools::check_rhub()
# Instale o pacote rhub se não tiver
install.packages("rhub")
# Verifique o pacote no R-hub
library(rhub)
rhub::check()
devtools::build()
devtools::submit_cran()
devtools::build()
