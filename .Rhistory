)
devtools::check(cran = TRUE, manual = FALSE, vignettes = FALSE)
library(AntClassify)
data("ant_community")
print(ant_community)
str(ant_community)
# Usar apenas a primeira coluna do dataset como entrada (uma única espécie)
comm_teste <- ant_community[, 1, drop = FALSE]
colnames(comm_teste)  # "Atta sexdens"
# Executar a validação (vai fazer uma chamada ao GBIF)
comm_validado <- validate_species_names(comm_teste, verbose = TRUE)
# Instale se não tiver: install.packages("rgbif")
rgbif::name_backbone("Atta sexdens")$matchType
name_encoded <- URLencode("Atta sexdens")
url <- paste0("https://api.gbif.org/v1/species/match?verbose=false&name=", name_encoded)
h <- curl::new_handle()
curl::handle_setopt(h, timeout = 30, useragent = "AntClassify/1.0")
res <- tryCatch(curl::curl_fetch_memory(url, handle = h), error = function(e) NULL)
if (is.null(res)) {
message("Erro de conexão ou timeout")
} else {
texto <- rawToChar(res$content)
dados <- tryCatch(jsonlite::fromJSON(texto), error = function(e) NULL)
print(dados)
}
devtools::build_vignettes()
list.files("vignettes")
list.files("inst/doc")
rmarkdown::render("vignettes/antclassify_workflow.Rmd", output_dir = "inst/doc")
file.edit("vignettes/antclassify_workflow.Rmd")
devtools::load_all(".")
devtools::build_vignettes()
devtools::check(cran = TRUE, manual = FALSE)
devtools::build(path = ".", manual = FALSE)
file.info("AntClassify_0.2.0.tar.gz")$size / 1024^2  # tamanho em MB
system("git status")
system("git add -A")
system('git commit -m "Update to version 0.2.0: new functions, corrected authors, improved vignette, and updated internal databases"')
system("git push origin main")
]
# replication.R
# Replication script for the JSS article:
# "AntClassify: An R Package for Standardized Classification
#  of Ant Communities, Functional Guilds, Endemism, and Rarity"
#
# This script reproduces all analyses and figures shown in the manuscript.
# It requires the AntClassify package (version >= 0.2.0) and a few CRAN packages.
# Load required packages
library(AntClassify)
library(ggplot2)
library(dplyr)
library(scales)
# ---------------------------------------------------------------------
# 1. Create the simulated dataset (identical to the article)
# ---------------------------------------------------------------------
species_abundance <- c(
Atta_sexdens = 50,
Camponotus_atriceps = 40,
Crematogaster_sp = 35,
Cyphomyrmex_minutus = 30,
Cyphomyrmex_rimosus = 28,
Ectatomma_edentatum = 25,
Heteroponera_mayri = 22,
Holcoponera_striatula = 20,
Monomorium_floricola = 18,
Monomorium_pharaonis = 17,
Pheidole_megacephala = 16,
Strumigenys_emmae = 15,
Strumigenys_rogeri = 14,
Nylanderia_fulva = 13,
Odontomachus_chelifer = 12,
Oxyepoecus_reticulatus = 11,
Pachycondyla_striata = 10,
Apterostigma_serratum = 9,
Brachymyrmex_delabiei = 8,
Brachymyrmex_feitosai = 7,
Camponotus_fallatus = 6,
Camponotus_hermanni = 5,
Camponotus_xanthogaster = 4,
Pheidole_aberrans = 3,
Pheidole_fimbriata = 3,
Pheidole_obscurithorax = 2,
Pheidole_subarmata = 2,
Strumigenys_fridericimuelleri = 2,
Heteroponera_inermis = 2,
Oxyepoecus_browni = 2,
Sphinctomyrmex_stali = 1,
Strumigenys_sanctipauli = 1,
Brachymyrmex_micromegas = 1,
Camponotus_tripartitus = 1,
Diaphoromyrma_sofiae = 1
)
comunidade <- data.frame(t(species_abundance))
names(comunidade) <- gsub("_", " ", names(species_abundance))
total_abundancia <- sum(comunidade)
# ---------------------------------------------------------------------
# 2. Functional guild classification (Table 1 and Figures 1-4)
# ---------------------------------------------------------------------
guilds <- assign_guild_ants(comunidade, validate = FALSE, plot = FALSE)
# Table 1 (first few rows)
tab_guilds <- head(guilds$table[, c("species", "abundance", "antclassify_guild",
"silva_guild", "delabie_guild", "silvestre_guild")])
print(tab_guilds)
# Generate guild plots (PDF with 4 pages)
pdf("antclassify-guilds-plot.pdf", width = 10, height = 7)
for (i in seq_along(guilds$plots)) {
print(guilds$plots[[i]])
}
dev.off()
# ---------------------------------------------------------------------
# 3. Exotic species (Table 2, Figures 5-6)
# ---------------------------------------------------------------------
exotics <- check_exotic_ants(comunidade, validate = FALSE, plot = FALSE)
# Table of exotic species (Table 2)
tab_exotics <- exotics$table[, c("species", "abundance", "percentage")]
print(tab_exotics)
# Generate exotic plots (2 pages: status + species)
exo_status <- check_exotic_ants(comunidade, validate = FALSE, plot = FALSE, plot_type = "status")
exo_species <- check_exotic_ants(comunidade, validate = FALSE, plot = FALSE, plot_type = "species")
pdf("antclassify-exotics-plot.pdf", width = 9, height = 6)
print(exo_status$plot)
print(exo_species$plot)
dev.off()
# ---------------------------------------------------------------------
# 4. Endemic species (Table 3, Figures 7-8)
# ---------------------------------------------------------------------
endemics <- check_endemic_atlantic_ants(comunidade, validate = FALSE, plot = FALSE)
# Table of endemic species (Table 3)
tab_endemics <- endemics$table[, c("species", "abundance", "percentage")]
print(tab_endemics)
# Generate endemic plots (2 pages: status + species)
end_status <- check_endemic_atlantic_ants(comunidade, validate = FALSE, plot = FALSE, plot_type = "status")
end_species <- check_endemic_atlantic_ants(comunidade, validate = FALSE, plot = FALSE, plot_type = "species")
pdf("antclassify-endemics-plot.pdf", width = 9, height = 6)
print(end_status$plot)
print(end_species$plot)
dev.off()
# ---------------------------------------------------------------------
# 5. Rarity classification (Table 4, Figures 9-10)
# ---------------------------------------------------------------------
rarity <- check_rarity_atlantic_ants(comunidade, validate = FALSE, plot = FALSE)
# Table of rare species (Table 4)
tab_rarity <- rarity$table[, c("species", "rarity_form", "abundance", "percentage")]
print(tab_rarity)
# Generate rarity plots (2 pages: status + species)
rar_status <- check_rarity_atlantic_ants(comunidade, validate = FALSE, plot = FALSE, plot_type = "status")
rar_species <- check_rarity_atlantic_ants(comunidade, validate = FALSE, plot = FALSE, plot_type = "species")
pdf("antclassify-rarity-plot.pdf", width = 10, height = 6)
print(rar_status$plot)
print(rar_species$plot)
dev.off()
# ---------------------------------------------------------------------
# 6. Multi‑site analysis with antclassify_community()
# ---------------------------------------------------------------------
# Load or create a multi‑site dataset (using built‑in ant_community)
data(ant_community)
res_com <- antclassify_community(ant_community, guild_col = "antclassify_guild",
validate = FALSE)
# Site‑by‑guild abundance matrix
guild_abund <- res_com$guild_abundance
print(guild_abund)
# Guild richness per site
guild_rich <- res_com$guild_richness
print(guild_rich)
message("Replication script completed successfully.")
