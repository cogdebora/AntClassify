devtools::check()
file.remove("antclassify-endemics-plot.pdf")
file.remove("antclassify-exotics-plot.pdf")
file.remove("antclassify-guilds-plot.pdf")
file.remove("antclassify-rarity-plot.pdf")
file.remove("replication.R")
